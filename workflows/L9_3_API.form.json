      "value": "$box1_x"
    },
    {
      "path": "21.inputs.y",
      "value": "$box1_y"
    },
    {
      "path": "27.inputs.text",
      "value": "$box2_text"
    },
    {
      "path": "27.inputs.width",
      "value": "$box2_width"
    },
    {
      "path": "27.inputs.height",
      "value": "$box2_height"
    },
    {
      "path": "27.inputs.x",
      "value": "$box2_x"
    },
    {
      "path": "27.inputs.y",
      "value": "$box2_y"
    },
    {
      "path": "3.inputs.seed",
      "value": "$seed"
    },
    {
      "path": "3.inputs.steps",
      "value": "$steps"
    },
    {
      "path": "3.inputs.cfg",
      "value": "$cfg"
    },
    {
      "path": "3.inputs.sampler_name",
      "value": "$sampler_name"
    },
    {
      "path": "3.inputs.scheduler",
      "value": "$scheduler"
    },
    {
      "path": "3.inputs.denoise",
      "value": "$denoise"
    },
    {
      "path": "5.inputs.width",
      "value": "$width"
    },
    {
      "path": "5.inputs.height",
      "value": "$height"
    },
    {
      "path": "5.inputs.batch_size",
      "value": "$batch_size"
    },
    {
      "path": "4.inputs.ckpt_name",
      "value": "$ckpt_name"
    },
    {
      "path": "10.inputs.gligen_name",
      "value": "$gligen_model"
