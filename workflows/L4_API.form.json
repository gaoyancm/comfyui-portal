{
  "name": "L4_API",
  "fields": [
    {"name": "positive", "label": "正面提示词", "type": "textarea", "default": ""},
    {"name": "negative", "label": "负面提示词", "type": "textarea", "default": ""},
    {"name": "seed", "label": "随机种子", "type": "integer", "default": 0},
    {"name": "steps", "label": "步数", "type": "integer", "default": 20, "min": 1},
    {"name": "cfg", "label": "CFG", "type": "number", "default": 7.0, "min": 0},
    {"name": "sampler_name", "label": "采样器", "type": "select", "options": ["euler", "euler_a", "dpmpp_2m", "dpmpp_2m_sde", "ddim"] , "default": "euler"},
    {"name": "scheduler", "label": "调度器", "type": "select", "options": ["normal", "karras", "ddim_uniform"], "default": "normal"},
    {"name": "denoise", "label": "降噪强度", "type": "number", "default": 1.0, "min": 0, "max": 1, "step": 0.01},
    {"name": "width", "label": "宽度", "type": "integer", "default": 512, "min": 64},
    {"name": "height", "label": "高度", "type": "integer", "default": 512, "min": 64},
    {"name": "batch_size", "label": "批量大小", "type": "integer", "default": 1, "min": 1},
    {"name": "ckpt_name", "label": "模型(ckpt)", "type": "text", "default": "v1-5-pruned-emaonly-fp16.safetensors"},
    {"name": "filename_prefix", "label": "保存前缀", "type": "text", "default": "ComfyUI"}
  ],
  "mapping": [
    {"path": "3.inputs.seed", "value": "$seed"},
    {"path": "3.inputs.steps", "value": "$steps"},
    {"path": "3.inputs.cfg", "value": "$cfg"},
    {"path": "3.inputs.sampler_name", "value": "$sampler_name"},
    {"path": "3.inputs.scheduler", "value": "$scheduler"},
    {"path": "3.inputs.denoise", "value": "$denoise"},
    {"path": "6.inputs.text", "value": "$positive"},
    {"path": "7.inputs.text", "value": "$negative"},
    {"path": "5.inputs.width", "value": "$width"},
    {"path": "5.inputs.height", "value": "$height"},
    {"path": "5.inputs.batch_size", "value": "$batch_size"},
    {"path": "4.inputs.ckpt_name", "value": "$ckpt_name"},
    {"path": "9.inputs.filename_prefix", "value": "$filename_prefix"}
  ]
}
