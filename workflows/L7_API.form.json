{
  "name": "L7_API",
  "fields": [
    {"name": "positive1", "label": "正面提示词1", "type": "textarea", "default": "office style, long-legged asian office lady, wearing hanfu, sitting pose, showing half of one thigh, 2k resolution, looking straight ahead"},
    {"name": "positive2", "label": "正面提示词2", "type": "textarea", "default": "candid photo,ultra realistic"},
    {"name": "seed", "label": "随机种子", "type": "integer", "default": 596944321147751},
    {"name": "steps", "label": "步数", "type": "integer", "default": 25},
    {"name": "cfg", "label": "CFG", "type": "number", "default": 1.2},
    {"name": "sampler_name", "label": "采样器", "type": "select", "options": ["euler", "euler_a", "dpmpp_2m"], "default": "euler"},
    {"name": "scheduler", "label": "调度器", "type": "select", "options": ["normal", "karras", "ddim_uniform"], "default": "normal"},
    {"name": "guidance", "label": "Guidance", "type": "number", "default": 3.5},
    {"name": "width", "label": "宽度", "type": "integer", "default": 1280},
    {"name": "height", "label": "高度", "type": "integer", "default": 720},
    {"name": "vae_name", "label": "VAE", "type": "text", "default": "ae.safetensors"},
    {"name": "unet_name", "label": "UNet", "type": "text", "default": "flux1-dev-fp8.safetensors"},
    {"name": "lora_name", "label": "LoRA", "type": "text", "default": "F.1国风汉服_Flux_hanfu测试?.safetensors"},
    {"name": "strength_model", "label": "LoRA 强度", "type": "number", "default": 1.0},
    {"name": "filename_prefix", "label": "保存前缀", "type": "text", "default": "ComfyUI"}
  ],
  "mapping": [
    {"path": "53.inputs.text", "value": "$positive1"},
    {"path": "6.inputs.text", "value": "$positive2"},
    {"path": "59.inputs.seed", "value": "$seed"},
    {"path": "59.inputs.steps", "value": "$steps"},
    {"path": "59.inputs.cfg", "value": "$cfg"},
    {"path": "59.inputs.sampler_name", "value": "$sampler_name"},
    {"path": "59.inputs.scheduler", "value": "$scheduler"},
    {"path": "26.inputs.guidance", "value": "$guidance"},
    {"path": "27.inputs.width", "value": "$width"},
    {"path": "27.inputs.height", "value": "$height"},
    {"path": "10.inputs.vae_name", "value": "$vae_name"},
    {"path": "47.inputs.unet_name", "value": "$unet_name"},
    {"path": "66.inputs.lora_name", "value": "$lora_name"},
    {"path": "66.inputs.strength_model", "value": "$strength_model"},
    {"path": "63.inputs.filename_prefix", "value": "$filename_prefix"}
  ]
}
