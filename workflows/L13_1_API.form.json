{
  "name": "L13_1_API",
  "fields": [
    {
      "name": "tts_text",
      "label": "合成文本",
      "type": "textarea",
      "default": "　　妹妹今年30多岁了，从头到脚都是天生的，全是爸爸妈妈的馈赠，可杏子拍的视频老是遭人嫌弃，哥哥你千万别像他们一样嫌弃我\n　　多给我点鼓励行吗，我好想听到你为我加油打气，有你的支持，我才更有动力啊\n　　最后妹妹邀请你点我头像，去看看我主页的1号视频，或许对你有所帮助，都是妹妹想对你说的真心话'"
    },
    {
      "name": "instruct_text",
      "label": "风格提示",
      "type": "textarea",
      "default": "The gentle voice of a little girl"
    },
    {
      "name": "inference_mode",
      "label": "推理模式",
      "type": "text",
      "default": "自然语言控制"
    },
    {
      "name": "voice",
      "label": "音色",
      "type": "text",
      "default": "中文女"
    },
    {
      "name": "seed",
      "label": "随机种子",
      "type": "integer",
      "default": 1414
    },
    {
      "name": "speed",
      "label": "语速",
      "type": "number",
      "default": 1.5,
      "step": 0.1
    },
    {
      "name": "filename_prefix",
      "label": "保存前缀",
      "type": "text",
      "default": "audio/ComfyUI"
    }
  ],
  "mapping": [
    {
      "path": "2.inputs.text",
      "value": "$tts_text"
    },
    {
      "path": "15.inputs.text",
      "value": "$instruct_text"
    },
    {
      "path": "16.inputs.inference_mode",
      "value": "$inference_mode"
    },
    {
      "path": "16.inputs.sft_dropdown",
      "value": "$voice"
    },
    {
      "path": "16.inputs.seed",
      "value": "$seed"
    },
    {
      "path": "16.inputs.speed",
      "value": "$speed"
    },
    {
      "path": "14.inputs.filename_prefix",
      "value": "$filename_prefix"
    }
  ]
}