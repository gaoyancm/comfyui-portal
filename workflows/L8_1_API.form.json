{
  "name": "L8_1_API",
  "fields": [
    {
      "name": "positive",
      "label": "正面提示词",
      "type": "textarea",
      "default": "chaloujiusi,scenery,standing,（red dressing 2.0）, architecture,plant,flower,lattice,tree,window,table,east asian architecture,long hair,black hair,wooden floor,scroll,multiple girls,multiple boys,potted plant,teapot,board game,book,indoors,sunlight,lantern,chair,garden,day,short hair,blue flower,vase,cup,chinese_hanfu_clothes,"
    },
    {
      "name": "negative",
      "label": "负面提示词",
      "type": "textarea",
      "default": "(worst quality, low quality, illustration, 3d, 2d, painting, cartoons, sketch),,nsfw"
    },
    {
      "name": "seed_stage1",
      "label": "随机种子（阶段1）",
      "type": "integer",
      "default": 931076802472942
    },
    {
      "name": "seed_stage2",
      "label": "随机种子（阶段2）",
      "type": "integer",
      "default": 130255383110993
    },
    {
      "name": "steps",
      "label": "步数",
      "type": "integer",
      "default": 20,
      "min": 1
    },
    {
      "name": "cfg",
      "label": "CFG",
      "type": "number",
      "default": 8,
      "min": 0
    },
    {
      "name": "sampler_name",
      "label": "采样器",
      "type": "select",
      "default": "euler",
      "options": [
        "euler",
        "euler_a",
        "dpmpp_2m",
        "dpmpp_2m_sde",
        "ddim",
        "dpmpp_3m_sde_gpu"
      ]
    },
    {
      "name": "scheduler",
      "label": "调度器",
      "type": "select",
      "default": "normal",
      "options": [
        "normal",
        "karras",
        "ddim_uniform",
        "exponential"
      ]
    },
    {
      "name": "denoise_stage1",
      "label": "降噪强度（阶段1）",
      "type": "number",
      "default": 1,
      "min": 0,
      "max": 1,
      "step": 0.01
    },
    {
      "name": "denoise_stage2",
      "label": "降噪强度（阶段2）",
      "type": "number",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "step": 0.01
    },
    {
      "name": "width",
