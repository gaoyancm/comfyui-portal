      "default": 768,
      "min": 64
    },
    {
      "name": "height",
      "label": "高度",
      "type": "integer",
      "default": 1024,
      "min": 64
    },
    {
      "name": "batch_size",
      "label": "批量大小",
      "type": "integer",
      "default": 1,
      "min": 1
    },
    {
