{
  "name": "L15_1_API",
  "fields": [
    {
      "name": "image_path",
      "label": "输入图像",
      "type": "file",
      "default": "5.png",
      "allow_upload": true,
      "accept": "image/*",
      "file": {
        "kind": "image",
        "dirs": [
          "assets/images",
          "uploads"
        ],
        "extensions": [
          ".jpeg",
          ".jpg",
          ".png",
          ".webp"
        ]
      },
      "help": "可从 assets/images 或 uploads 选择/上传"
    },
    {
      "name": "audio_path",
      "label": "输入音频",
      "type": "file",
      "default": "ComfyUI_00008_.flac",
      "allow_upload": true,
      "accept": "audio/*",
      "file": {
        "kind": "audio",
        "dirs": [
          "assets/audio",
          "uploads"
        ],
        "extensions": [
          ".aac",
          ".flac",
          ".m4a",
          ".mp3",
          ".ogg",
          ".wav"
        ]
      },
      "help": "可从 assets/audio 或 uploads 选择/上传"
    },
    {
      "name": "duration",
      "label": "时长(秒)",
      "type": "number",
      "default": 3,
      "step": 0.1
    },
    {
      "name": "expand_ratio",
      "label": "扩展比例",
      "type": "number",
      "default": 0.5,
      "step": 0.05
    },
    {
      "name": "min_resolution",
      "label": "最小分辨率",
      "type": "integer",
      "default": 256
    },
    {
      "name": "ip_audio_scale",
      "label": "音频引导强度",
      "type": "number",
      "default": 1,
      "step": 0.1
    },
    {
      "name": "use_interframe",
      "label": "启用插帧",
      "type": "select",
      "default": true,
      "options": [
        true,
        false
      ]
    },
    {
      "name": "dtype",
      "label": "权重精度",
      "type": "text",
      "default": "fp16"
    },
    {
      "name": "sonic_unet",
      "label": "SONIC UNet",
      "type": "text",
      "default": "unet.pth"
    },
    {
      "name": "seed",
      "label": "随机种子",
      "type": "integer",
      "default": 443489271
    },
    {
      "name": "inference_steps",
      "label": "采样步数",
      "type": "integer",
      "default": 25,
      "min": 1
    },
    {
      "name": "fps",
      "label": "帧率",
      "type": "integer",
      "default": 25,
      "min": 1
    },
    {
      "name": "dynamic_scale",
      "label": "动态缩放",
      "type": "number",
      "default": 1,
      "step": 0.1
    },
    {
      "name": "ckpt_name",
      "label": "模型(ckpt)",
      "type": "text",
      "default": "svd_xt_1_1.safetensors"
    },
    {
      "name": "filename_prefix",
      "label": "视频前缀",
      "type": "text",
      "default": "video/ComfyUI"
    },
    {
      "name": "format",
      "label": "封装格式",
      "type": "text",
      "default": "mp4"
    },
    {
      "name": "codec",
      "label": "编码器",
      "type": "text",
      "default": "h264"
    }
  ],
  "mapping": [
    {
      "path": "18.inputs.image",
      "value": "$file:image_path"
    },
    {
      "path": "19.inputs.audio",
      "value": "$file:audio_path"
    },
    {
      "path": "17.inputs.duration",
      "value": "$duration"
    },
    {
      "path": "17.inputs.expand_ratio",
      "value": "$expand_ratio"
    },
    {
      "path": "17.inputs.min_resolution",
      "value": "$min_resolution"
    },
    {
      "path": "14.inputs.ip_audio_scale",
      "value": "$ip_audio_scale"
    },
    {
      "path": "14.inputs.use_interframe",
      "value": "$use_interframe"
    },
    {
      "path": "14.inputs.dtype",
      "value": "$dtype"
    },
    {
      "path": "14.inputs.sonic_unet",
      "value": "$sonic_unet"
    },
    {
      "path": "15.inputs.seed",
      "value": "$seed"
    },
    {
      "path": "15.inputs.inference_steps",
      "value": "$inference_steps"
    },
    {
      "path": "15.inputs.fps",
      "value": "$fps"
    },
    {
      "path": "15.inputs.dynamic_scale",
      "value": "$dynamic_scale"
    },
    {
      "path": "16.inputs.ckpt_name",
      "value": "$ckpt_name"
    },
    {
      "path": "20.inputs.filename_prefix",
      "value": "$filename_prefix"
    },
    {
      "path": "20.inputs.format",
      "value": "$format"
    },
    {
      "path": "20.inputs.codec",
      "value": "$codec"
    }
  ]
}